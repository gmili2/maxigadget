# MAXIGADGET — site (Vite) sur hébergement cPanel Namecheap.
# Copié tel quel dans dist/ à la construction, puis déployé dans le dossier du domaine.
DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Adresse unique : https://maxigadget.store (sans www). Le certificat SSL est géré par l'hébergement.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # /api est servi par l'application Node.js (cPanel → Setup Node.js App).
  RewriteRule ^api(/|$) - [L]

  # Fichiers et dossiers existants : servis directement.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Toutes les autres adresses (/produits, /admin…) : application React.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Fichiers versionnés par Vite : cache d'un an. index.html : toujours revalidé.
  <FilesMatch "\.(js|css|woff2?|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
