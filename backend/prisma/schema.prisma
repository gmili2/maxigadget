// MAXIGADGET — schéma de base de données (MariaDB)
// Montants en centimes (Int) : jamais de float pour l'argent.
// Contraintes CHECK et index full-text ajoutés en SQL brut dans la migration initiale
// (voir prisma/migrations/0001_init/extra.sql).

generator client {
  provider      = "prisma-client-js"
  // native : machine de développement ; rhel-openssl-* : serveurs mutualisés Namecheap (CloudLinux 8 et 9).
  binaryTargets = ["native", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql" // MariaDB 11.4 (hébergement Namecheap)
  url      = env("DATABASE_URL")
}

// ───────────────────────── Enums

enum Role {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MovementType {
  AUTOMATIC
  MANUAL
  QUARTZ
  SOLAR
  KINETIC
}

enum Gender {
  MEN
  WOMEN
  UNISEX
}

enum StorageProvider {
  CLOUDINARY
  S3
  LOCAL // fichier servi par le front (dossier public/), en attendant Cloudinary/S3
}

enum StockReason {
  INITIAL
  RESTOCK
  ADJUSTMENT
  ORDER_RESERVED
  ORDER_CANCELLED
  ORDER_REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CARD
  CASH_ON_DELIVERY
  BANK_TRANSFER // virement reçu avant expédition
}

enum PaymentProvider {
  STRIPE
  COD
  BANK_TRANSFER
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  IN_TRANSIT
  DELIVERED
  RETURNED
  FAILED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

// ───────────────────────── Utilisateurs & authentification

model User {
  id              String     @id @default(uuid()) @db.Char(36)
  email           String     @unique @db.VarChar(254) // collation insensible à la casse
  passwordHash    String     @db.VarChar(255)
  firstName       String     @db.VarChar(80)
  lastName        String     @db.VarChar(80)
  phone           String?    @db.VarChar(30)
  role            Role       @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  sessions    Session[]
  tokens      UserToken[]
  addresses   Address[]
  cart        Cart?
  wishlist    Wishlist?
  orders      Order[]
  reviews     Review[]
  redemptions CouponRedemption[]
  moderated   Review[]           @relation("ReviewModerator")
  auditLogs   AuditLog[]

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

/// Refresh tokens (rotation + détection de réutilisation). Seul le hash est stocké.
model Session {
  id           String    @id @default(uuid()) @db.Char(36)
  userId       String    @db.Char(36)
  tokenHash    String    @unique @db.Char(64)
  familyId     String    @db.Char(36)
  userAgent    String?   @db.VarChar(255)
  ip           String?   @db.VarChar(45)
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Char(36)
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

/// Jetons à usage unique : vérification d'email, réinitialisation du mot de passe.
model UserToken {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @db.Char(36)
  type      TokenType
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("user_tokens")
}

model Address {
  id         String   @id @default(uuid()) @db.Char(36)
  userId     String   @db.Char(36)
  label      String?  @db.VarChar(40)
  firstName  String   @db.VarChar(80)
  lastName   String   @db.VarChar(80)
  line1      String   @db.VarChar(160)
  line2      String?  @db.VarChar(160)
  city       String   @db.VarChar(100)
  postalCode String   @db.VarChar(20)
  country    String   @db.Char(2) // ISO 3166-1 alpha-2
  phone      String   @db.VarChar(30)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ───────────────────────── Catalogue

model Brand {
  id          String   @id @default(uuid()) @db.Char(36)
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.Text
  logoUrl     String?  @db.VarChar(500)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]
  collections Collection[]

  @@map("brands")
}

/// Catégories hiérarchiques : parentId = null → catégorie, sinon sous-catégorie.
model Category {
  id          String   @id @default(uuid()) @db.Char(36)
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.Text
  parentId    String?  @db.Char(36)
  imageUrl    String?  @db.VarChar(500)
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent           Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children         Category[]        @relation("CategoryTree")
  products         Product[]
  promotionTargets PromotionTarget[]

  @@index([parentId, position])
  @@map("categories")
}

model Collection {
  id          String   @id @default(uuid()) @db.Char(36)
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.Text
  brandId     String?  @db.Char(36)
  coverUrl    String?  @db.VarChar(500)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand            Brand?            @relation(fields: [brandId], references: [id], onDelete: SetNull)
  products         Product[]
  promotionTargets PromotionTarget[]

  @@index([brandId])
  @@map("collections")
}

model Product {
  id                String        @id @default(uuid()) @db.Char(36)
  name              String        @db.VarChar(160)
  slug              String        @unique @db.VarChar(180)
  shortDescription  String?       @db.VarChar(300)
  description       String        @db.Text
  reference         String        @db.VarChar(60)
  sku               String        @unique @db.VarChar(60)
  currency          String        @default("MAD") @db.Char(3)
  priceCents        Int
  salePriceCents    Int?
  saleStartsAt      DateTime?
  saleEndsAt        DateTime?
  stock             Int           @default(0)
  lowStockThreshold Int           @default(3)
  /// true : toujours commandable, aucun stock décompté (fabrication à la demande, fournisseur sans rupture).
  unlimitedStock    Boolean       @default(false)
  status            ProductStatus @default(DRAFT)
  isFeatured        Boolean       @default(false)
  /// false : produit présenté en vitrine, impossible à commander (contrôlé par l\'API).
  purchasable       Boolean       @default(true)
  gender            Gender        @default(UNISEX)

  brandId      String  @db.Char(36)
  categoryId   String  @db.Char(36)
  collectionId String? @db.Char(36)

  // Caractéristiques techniques (colonnes dédiées = filtrables et indexables)
  movementType      MovementType
  caliber           String?      @db.VarChar(60)
  caseMaterial      String       @db.VarChar(60)
  strapMaterial     String       @db.VarChar(60)
  color             String       @db.VarChar(40) // couleur principale (filtre)
  dialColor         String?      @db.VarChar(40)
  diameterMm        Decimal      @db.Decimal(4, 1)
  thicknessMm       Decimal?     @db.Decimal(4, 1)
  lugWidthMm        Int?
  waterResistanceM  Int
  glass             String       @db.VarChar(60)
  powerReserveHours Int?
  warrantyMonths    Int          @default(24)
  extraSpecs        Json? // caractéristiques libres non filtrables

  // Dénormalisations maintenues par le backend (tri popularité / note)
  soldCount   Int     @default(0)
  ratingAvg   Decimal @default(0) @db.Decimal(2, 1)
  ratingCount Int     @default(0)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  brand      Brand       @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  images           ProductImage[]
  videos           ProductVideo[]
  options          ProductOption[]
  variants         ProductVariant[]
  stockMovements   StockMovement[]
  cartItems        CartItem[]
  wishlistItems    WishlistItem[]
  orderItems       OrderItem[]
  reviews          Review[]
  promotionTargets PromotionTarget[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([status, categoryId])
  @@index([status, brandId])
  @@index([status, collectionId])
  @@index([status, priceCents])
  @@index([status, soldCount(sort: Desc)])
  @@index([movementType])
  @@index([color])
  @@index([stock])
  @@fulltext([name, description], map: "products_fulltext")
  @@map("products")
}

/// Les fichiers vivent chez Cloudinary / S3 ; la base ne garde que les métadonnées.
model ProductImage {
  id         String          @id @default(uuid()) @db.Char(36)
  productId  String          @db.Char(36)
  provider   StorageProvider
  storageKey String          @db.VarChar(255) // public_id Cloudinary ou clé S3
  url        String          @db.VarChar(500)
  alt        String?         @db.VarChar(160)
  width      Int?
  height     Int?
  position   Int             @default(0)
  isPrimary  Boolean         @default(false)
  createdAt  DateTime        @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_images")
}

/// Vidéos d'une montre (MP4, MOV ou WebM), affichées après les photos sur la fiche.
model ProductVideo {
  id         String   @id @default(uuid()) @db.Char(36)
  productId  String   @db.Char(36)
  storageKey String   @db.VarChar(255)
  url        String   @db.VarChar(500)
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_videos")
}

/// Option configurable d'un produit (Couleur, Bracelet, Taille…). Ordre d'affichage par `position`.
model ProductOption {
  id        String   @id @default(uuid()) @db.Char(36)
  productId String   @db.Char(36)
  name      String   @db.VarChar(40)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@unique([productId, name])
  @@index([productId, position])
  @@map("product_options")
}

/// Valeur d'une option. `colorHex` affiche une pastille (options de type couleur).
model ProductOptionValue {
  id       String  @id @default(uuid()) @db.Char(36)
  optionId String  @db.Char(36)
  label    String  @db.VarChar(60)
  colorHex String? @db.VarChar(7)
  position Int     @default(0)

  option   ProductOption         @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants ProductVariantValue[]

  @@unique([optionId, label])
  @@index([optionId, position])
  @@map("product_option_values")
}

/// Déclinaison vendable : une combinaison de valeurs, avec son SKU et son stock.
/// Quand un produit a des déclinaisons, `products.stock` vaut la somme de leurs stocks (maintenue par l'API).
/// `priceCents` / `salePriceCents` nuls : le prix du produit s'applique.
model ProductVariant {
  id             String   @id @default(uuid()) @db.Char(36)
  productId      String   @db.Char(36)
  sku            String   @unique @db.VarChar(60)
  priceCents     Int?
  salePriceCents Int?
  stock          Int      @default(0)
  isActive       Boolean  @default(true)
  imageUrl       String?  @db.VarChar(500)
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product        Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  values         ProductVariantValue[]
  stockMovements StockMovement[]
  cartItems      CartItem[]
  orderItems     OrderItem[]

  @@index([productId, position])
  @@map("product_variants")
}

model ProductVariantValue {
  variantId     String @db.Char(36)
  optionValueId String @db.Char(36)

  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
  @@map("product_variant_values")
}

/// Journal de stock : chaque variation est tracée (audit, réconciliation).
model StockMovement {
  id        String      @id @default(uuid()) @db.Char(36)
  productId String      @db.Char(36)
  variantId String?     @db.Char(36)
  delta     Int
  reason    StockReason
  orderId   String?     @db.Char(36)
  actorId   String?     @db.Char(36)
  note      String?     @db.VarChar(255)
  createdAt DateTime    @default(now())

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  order   Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@map("stock_movements")
}

// ───────────────────────── Panier & wishlist

/// Panier utilisateur (userId) ou invité (guestToken). Les prix ne sont jamais stockés ici :
/// ils sont recalculés côté serveur à chaque lecture.
model Cart {
  id         String    @id @default(uuid()) @db.Char(36)
  userId     String?   @unique @db.Char(36)
  guestToken String?   @unique @db.VarChar(64)
  couponId   String?   @db.Char(36)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user   User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items  CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Char(36)
  cartId    String   @db.Char(36)
  productId String   @db.Char(36)
  variantId String?  @db.Char(36)
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  /// Unicité d'une ligne sans déclinaison (variantId NULL) assurée par l'API.
  @@unique([cartId, productId, variantId])
  @@map("cart_items")
}

model Wishlist {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @unique @db.Char(36)
  createdAt DateTime @default(now())

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(uuid()) @db.Char(36)
  wishlistId String   @db.Char(36)
  productId  String   @db.Char(36)
  createdAt  DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId]) // empêche les doublons
  @@map("wishlist_items")
}

// ───────────────────────── Commandes

model Order {
  id            String        @id @default(uuid()) @db.Char(36)
  number        String        @unique @db.VarChar(20) // GM-2026-000123
  userId        String        @db.Char(36)
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod PaymentMethod
  currency      String        @default("MAD") @db.Char(3)

  subtotalCents Int
  shippingCents Int
  discountCents Int @default(0)
  taxCents      Int @default(0) // TVA incluse, ventilée pour la facture
  totalCents    Int

  couponId   String? @db.Char(36)
  couponCode String? @db.VarChar(40) // snapshot

  // Snapshots : l'adresse de la commande ne change pas si le client modifie son carnet.
  shippingAddress Json
  billingAddress  Json?

  shippingMethodId   String? @db.Char(36)
  shippingMethodName String  @db.VarChar(80)
  customerNote       String? @db.VarChar(500)
  idempotencyKey     String? @unique @db.VarChar(64)

  placedAt    DateTime  @default(now())
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user           User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  coupon         Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  shippingMethod ShippingMethod?      @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  payments       Payment[]
  shipments      Shipment[]
  history        OrderStatusHistory[]
  stockMovements StockMovement[]
  redemption     CouponRedemption?
  reviews        Review[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

/// Prix et libellés figés au moment de l'achat.
model OrderItem {
  id             String  @id @default(uuid()) @db.Char(36)
  orderId        String  @db.Char(36)
  productId      String? @db.Char(36)
  variantId      String? @db.Char(36)
  productName    String  @db.VarChar(160)
  variantLabel   String? @db.VarChar(160) // ex. « Bleu nuit · Cuir »
  sku            String  @db.VarChar(60)
  imageUrl       String? @db.VarChar(500)
  unitPriceCents Int
  quantity       Int
  totalCents     Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String       @id @default(uuid()) @db.Char(36)
  orderId   String       @db.Char(36)
  from      OrderStatus?
  to        OrderStatus
  note      String?      @db.VarChar(255)
  actorId   String?      @db.Char(36)
  createdAt DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ───────────────────────── Paiements

/// Aucune donnée de carte n'est stockée : seulement les identifiants Stripe.
model Payment {
  id                String          @id @default(uuid()) @db.Char(36)
  orderId           String          @db.Char(36)
  provider          PaymentProvider
  providerPaymentId String?         @unique @db.VarChar(120) // pi_xxx
  amountCents       Int
  currency          String          @db.Char(3)
  status            PaymentStatus   @default(PENDING)
  refundedCents     Int             @default(0)
  failureReason     String?         @db.VarChar(255)
  paidAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

model Refund {
  id               String       @id @default(uuid()) @db.Char(36)
  paymentId        String       @db.Char(36)
  providerRefundId String?      @unique @db.VarChar(120)
  amountCents      Int
  reason           String?      @db.VarChar(255)
  status           RefundStatus @default(PENDING)
  actorId          String?      @db.Char(36)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@map("refunds")
}

/// Idempotence des webhooks : un événement n'est traité qu'une fois.
model WebhookEvent {
  id          String          @id @default(uuid()) @db.Char(36)
  provider    PaymentProvider
  eventId     String          @unique @db.VarChar(120)
  type        String          @db.VarChar(80)
  payload     Json
  processedAt DateTime?
  error       String?         @db.Text
  createdAt   DateTime        @default(now())

  @@map("webhook_events")
}

// ───────────────────────── Livraison (règles éditables depuis l'admin)

model ShippingZone {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String   @db.VarChar(80)
  countries Json // tableau de codes ISO alpha-2, ex. ["MA"]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  methods ShippingMethod[]

  @@map("shipping_zones")
}

model ShippingMethod {
  id             String   @id @default(uuid()) @db.Char(36)
  zoneId         String   @db.Char(36)
  name           String   @db.VarChar(80)
  carrier        String   @db.VarChar(60)
  priceCents     Int
  freeAboveCents Int?
  minDays        Int
  maxDays        Int
  codAllowed     Boolean  @default(false)
  codFeeCents    Int      @default(0)
  isActive       Boolean  @default(true)
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  zone   ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([zoneId, isActive])
  @@map("shipping_methods")
}

model Shipment {
  id             String         @id @default(uuid()) @db.Char(36)
  orderId        String         @db.Char(36)
  carrier        String         @db.VarChar(60)
  trackingNumber String?        @db.VarChar(80)
  trackingUrl    String?        @db.VarChar(500)
  status         ShipmentStatus @default(PENDING)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([trackingNumber])
  @@map("shipments")
}

// ───────────────────────── Coupons & promotions

model Coupon {
  id               String       @id @default(uuid()) @db.Char(36)
  code             String       @unique @db.VarChar(40) // collation insensible à la casse
  type             DiscountType
  value            Int // PERCENTAGE : 1–100 ; FIXED_AMOUNT : centimes
  maxDiscountCents Int?
  minOrderCents    Int          @default(0)
  startsAt         DateTime?
  expiresAt        DateTime?
  maxUses          Int?
  maxUsesPerUser   Int          @default(1)
  usedCount        Int          @default(0)
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  redemptions CouponRedemption[]
  orders      Order[]
  carts       Cart[]

  @@index([isActive, expiresAt])
  @@map("coupons")
}

model CouponRedemption {
  id          String   @id @default(uuid()) @db.Char(36)
  couponId    String   @db.Char(36)
  userId      String   @db.Char(36)
  orderId     String   @unique @db.Char(36)
  amountCents Int
  createdAt   DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

/// Promotion automatique (sans code) ciblant produits, catégories ou collections.
model Promotion {
  id        String       @id @default(uuid()) @db.Char(36)
  name      String       @db.VarChar(100)
  type      DiscountType
  value     Int
  startsAt  DateTime
  endsAt    DateTime
  isActive  Boolean      @default(true)
  priority  Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  targets PromotionTarget[]

  @@index([isActive, startsAt, endsAt])
  @@map("promotions")
}

model PromotionTarget {
  id           String  @id @default(uuid()) @db.Char(36)
  promotionId  String  @db.Char(36)
  productId    String? @db.Char(36)
  categoryId   String? @db.Char(36)
  collectionId String? @db.Char(36)

  promotion  Promotion   @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product    Product?    @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category?   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([categoryId])
  @@index([collectionId])
  @@map("promotion_targets")
}

// ───────────────────────── Avis

model Review {
  id            String       @id @default(uuid()) @db.Char(36)
  productId     String       @db.Char(36)
  userId        String       @db.Char(36)
  orderId       String       @db.Char(36) // preuve d'achat
  rating        Int // 1–5 (CHECK SQL)
  title         String?      @db.VarChar(120)
  comment       String       @db.VarChar(2000)
  status        ReviewStatus @default(PENDING)
  moderatedById String?      @db.Char(36)
  moderatedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  moderatedBy User?   @relation("ReviewModerator", fields: [moderatedById], references: [id], onDelete: SetNull)

  @@unique([userId, productId]) // un avis par produit et par client
  @@index([productId, status, createdAt(sort: Desc)])
  @@map("reviews")
}

// ───────────────────────── Emails & audit

/// Outbox : les emails sont écrits ici dans la transaction métier, puis envoyés par un worker.
model EmailOutbox {
  id                String      @id @default(uuid()) @db.Char(36)
  to                String      @db.VarChar(254)
  template          String      @db.VarChar(60)
  payload           Json
  status            EmailStatus @default(QUEUED)
  attempts          Int         @default(0)
  providerMessageId String?     @db.VarChar(120)
  error             String?     @db.Text
  sendAfter         DateTime    @default(now())
  sentAt            DateTime?
  createdAt         DateTime    @default(now())

  @@index([status, sendAfter])
  @@map("email_outbox")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Char(36)
  actorId   String?  @db.Char(36)
  action    String   @db.VarChar(60) // product.update, order.refund…
  entity    String   @db.VarChar(40)
  entityId  String?  @db.VarChar(60)
  changes   Json?
  ip        String?  @db.VarChar(45)
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}
